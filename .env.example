SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_PORT=8000

# Local development defaults. Compose uses db:5432 inside containers.
POSTGRES_DB=uzistore
POSTGRES_USER=uzistore
POSTGRES_PASSWORD=uzistore-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Compose overrides these with the Redis service address.
REDIS_LOCATION=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

PAYMENT_GATEWAY_API_KEY=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=
